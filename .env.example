# URL pubblico usato dallo script QR (npm run qr)
BASE_URL=http://localhost:3000

# Credenziali Basic Auth per /admin (obbligatorie: senza, /admin risponde 503)
ADMIN_USER=admin
ADMIN_PASS=change-me

# Banner consenso: "eu" (default: utenti EU/SEE/UK o paese sconosciuto), "always", "off"
CONSENT_BANNER=eu

# Storage. Senza TURSO_DATABASE_URL si usa SQLite locale (better-sqlite3).
# SQLITE_PATH=./data/video-tracker.db
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Override opzionale della sorgente di un video: VIDEO_SRC_<ID in maiuscolo, non alfanumerici -> _>
# VIDEO_SRC_SAMPLE=https://cdn.example.com/sample.mp4
